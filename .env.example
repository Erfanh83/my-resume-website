# Contact form delivery (EmailJS).
# Create a free account at https://www.emailjs.com, add an email service and a
# template, then copy the three IDs here into a file named .env.local.
# The template must accept these variables: from_name, from_email, subject, message.
# Without these the form validates but tells the visitor to email directly.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
